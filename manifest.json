{
  "manifest_version": 3,
  "name": "Full Page Screenshot",
  "version": "1.2.0",
  "description": "Capture the visible area or the entire web page, including inner scroll areas, as a high-resolution PNG or JPG.",
  "permissions": ["activeTab", "scripting", "storage", "debugger"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Take screenshot",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
